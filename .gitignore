# Julia package artifacts
/Manifest.toml
/LocalPreferences.toml
*.jl.cov
*.jl.*.cov
*.jl.mem

# Test, docs, and benchmark outputs
/docs/build/
/coverage/
/benchmarks/results/

# Experiment outputs: regenerated by `julia --project=experiments experiments/run_all.jl`.
/experiments/results/
/experiments/Manifest.toml

# Experiment figures mirrored into the docs by docs/gallery.jl at build time.
# The source of truth is experiments/results/<slug>/figure.png (generated, gitignored).
/docs/src/assets/experiments/

# Editor and OS noise
.DS_Store
.vscode/
.idea/
.codex/
.mimocode/

# Logs and scratch files
*.log
*.tmp
*.swp
